# Copy to .env and set real passwords. .env is git-ignored and loaded
# automatically; variables already set in the environment take precedence.

# app (runtime): least-privilege role used by `filemaster watch`, `sessions`, `history`
export DATABASE_URL="postgres://fm_app:app_pw_change_me@localhost:5432/filemaster?sslmode=disable&pool_max_conns=8&application_name=filemaster"
# migrations only: schema owner. When set, the watcher applies pending
# migrations at startup, then disconnects it. Remove it to keep owner
# credentials off this machine; upgrades then need `filemaster migrate up`.
export MIGRATE_DATABASE_URL="postgres://fm_owner:owner_pw_change_me@localhost:5432/filemaster?sslmode=disable"
